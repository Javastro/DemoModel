

@startuml

' hide the spot
' hide circle

' avoid problems with angled crows feet
skinparam linetype ortho
        
entity "DemoDM.PhotometricSystem" as DemoDM.PhotometricSystem {

    ID : BIGINT

---

    description : VARCHAR
detectorType : INTEGER

}

entity "DemoDM.PhotometryFilter" as DemoDM.PhotometryFilter {

    ID : BIGINT

---

    PHOTOMETRICSYSTEM_ID : BIGINT
name : VARCHAR
description : VARCHAR
bandName : VARCHAR
dataValidityFrom : TIMESTAMP
dataValidityTo : TIMESTAMP
spectralLocation_value : DOUBLE
spectralLocation_unit : VARCHAR

---
      PHOTOMETRICSYSTEM_ID : BIGINT<<FK>>

}

entity "DemoDM.AbstractSource" as DemoDM.AbstractSource {

    ID : BIGINT
position_frame : VARCHAR

---

    SOURCECATALOGUE_ID : BIGINT
name : VARCHAR
description : VARCHAR
position_coord_alpha : DOUBLE
position_coord_delta : DOUBLE
positionError_longError : DOUBLE
positionError_latError : DOUBLE
positionError_radius : DOUBLE
positionError_major : DOUBLE
positionError_minor : DOUBLE
positionError_pa : DOUBLE
classification : VARCHAR

---
      SOURCECATALOGUE_ID : BIGINT<<FK>>
ID : BIGINT<<FK>>
position_frame : VARCHAR<<FK>>

}

entity "DemoDM.AstroObject" as DemoDM.AstroObject {

    ID : BIGINT

---

    objectType : VARCHAR

}

entity "DemoDM.LuminosityMeasurement" as DemoDM.LuminosityMeasurement {

    ID : BIGINT

---

    ABSTRACTSOURCE_ID : BIGINT
value_value : DOUBLE
value_unit : VARCHAR
error_value : DOUBLE
error_unit : VARCHAR
description : VARCHAR
type : VARCHAR
filter : BIGINT

---
      filter : BIGINT<<FK>>
ABSTRACTSOURCE_ID : BIGINT<<FK>>

}

entity "DemoDM.SDSSSource" as DemoDM.SDSSSource {

    ID : BIGINT

---

    
---
      ID : BIGINT<<FK>>

}

entity "DemoDM.SkyCoordinateFrame" as DemoDM.SkyCoordinateFrame {

    name : VARCHAR

---

    documentURI : VARCHAR
equinox : VARCHAR
system : VARCHAR

}

entity "DemoDM.Source" as DemoDM.Source {

    ID : BIGINT

---

    
---
      ID : BIGINT<<FK>>

}

entity "DemoDM.TwoMassSource" as DemoDM.TwoMassSource {

    ID : BIGINT

---

    
---
      ID : BIGINT<<FK>>

}

entity "DemoDM.Testing" as DemoDM.Testing {

    ID : BIGINT

---

    SOURCECATALOGUE_ID : BIGINT
plain : VARCHAR
unbounded : VARCHAR
apoint_alpha : DOUBLE
apoint_delta : DOUBLE
acircle_center_alpha : DOUBLE
acircle_center_delta : DOUBLE
acircle_radius : DOUBLE
apoly_points_alpha : DOUBLE
apoly_points_delta : DOUBLE

---
      SOURCECATALOGUE_ID : BIGINT<<FK>>

}

entity "DemoDM.SourceCatalogue" as DemoDM.SourceCatalogue {

    ID : BIGINT

---

    name : VARCHAR

}


        DemoDM.PhotometryFilter }o--||DemoDM.PhotometricSystem
DemoDM.AbstractSource }o--||DemoDM.SourceCatalogue
DemoDM.AbstractSource }o--||DemoDM.AstroObject
DemoDM.AbstractSource }o--||DemoDM.SkyCoordinateFrame
DemoDM.LuminosityMeasurement }o--||DemoDM.PhotometryFilter
DemoDM.LuminosityMeasurement }o--||DemoDM.AbstractSource
DemoDM.SDSSSource }o--||DemoDM.AbstractSource
DemoDM.Source }o--||DemoDM.AbstractSource
DemoDM.TwoMassSource }o--||DemoDM.AbstractSource
DemoDM.Testing }o--||DemoDM.SourceCatalogue



@enduml

    